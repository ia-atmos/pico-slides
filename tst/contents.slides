;; the table of contents: a block made from the sections
:Slides [
    font = [file="../res/DejaVuSans.ttf"],
    :Slide [ title="Agenda",
        :Contents [],
    ],
    :Section [ title="Introduction",
        :Slide [ title="In the first section",
            :Row [ :Contents [ anchor=:W ], "the other sections are dimmed" ],
        ],
    ],
    :Section [ title="Objectives", color=[bg=:navy, fg=:white],
        :Slide [
            :Contents [ anchor=:C, font=[size=0.08] ],
        ],
    ],
    :Section [ title="Conclusion",
        :Slide [ "the end" ],
    ],
]
