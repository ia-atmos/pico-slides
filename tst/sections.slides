;; sections, the styles they give, and the keys (toc=false: only the
;; slides that are written)
:Slides [ toc=false,
    font = [file="../res/DejaVuSans.ttf"],
    :Slide [ title="Cover", "slide 1" ],
    :Section [ title="First", color=[bg=:navy, fg=:white],
        :Slide [ title="In the first section", "slide 2" ],
        :Slide [ "slide 3, with no title" ],
    ],
    :Section [ title="Second", anchor=:W, font=[size=0.08],
        :Slide [ title="In the second section", "slide 4" ],
    ],
]
