;; Plays a presentation written as data, or saves it as images:
;;
;;   atmos-pico main.atm <file> [<width> <height> [<prefix> [steps]]]
;;
;; The file is read with `X.loadx` (see doc/design.md). The paths in it
;; (images, fonts) are relative to the current directory. With a
;; prefix, the slides are saved as `<prefix>0001.png` and so on, and
;; the program ends: one image for each slide, or for each step of each
;; slide if the last argument is `steps`.

include "slides.atm"

val path, w, h, prefix, steps = ...

if path == nil {
    print("usage: main.atm <file> [<width> <height> [<prefix> [steps]]]")
    os.exit(1)
}

val f, msg = io.open(path)
if f == nil {
    print("slides : " ++ path ++ " : " ++ msg)
    os.exit(1)
}

pin doc = X.loadx(io.read(f, :all))
Slides.check(doc)

pico.open [ title="pico-slides" ]
pico.set.aids(false)
pico.set.layer(pico.layer.window)
pico.set.effect [ color=:black ]       ;; the bars of `fit=:bars`
pico.set.scene [ dim=['!',
    w=(tonumber(w) || Slides.dflt.win.w),
    h=(tonumber(h) || Slides.dflt.win.h),
] ]
pico.set.layer(pico.layer.world)

if prefix == nil {
    await Slides.Play(doc)
} else {
    pico.set.expert(true, true)         ;; as fast as possible
    val n = await Slides.Export(doc, prefix, steps == "steps")
    print("slides : " ++ n ++ " pages")
}
